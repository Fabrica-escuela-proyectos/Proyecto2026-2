digraph MER {
  graph [rankdir=LR, splines=true, nodesep=0.45, ranksep=0.9, fontname="Helvetica", bgcolor="white", fontsize=15, labelloc=t,
         label="Plataforma de Reservas · MER físico real (Flyway V1–V12, PostgreSQL 16)\nPK subrayada · etiqueta = ON DELETE · azul: Sprint 1 · verde: Sprint 2 · celda verde clara: columna agregada en Sprint 2"];
  node [shape=plaintext, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8, color="#555555", arrowhead=crow, arrowtail=tee, dir=both];
  users [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1f4e79"><font color="white"><b>users</b> (V1)</font></td></tr>
   <tr><td align="left"><u>id</u> UUID</td></tr><tr><td align="left">full_name · email UK · phone_number UK</td></tr><tr><td align="left">password_hash · enabled · created_at</td></tr></table>>];
  roles [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1f4e79"><font color="white"><b>roles</b> (V1)</font></td></tr>
   <tr><td align="left"><u>id</u> · name UK</td></tr><tr><td align="left">CLIENTE · PROVEEDOR · ADMINISTRADOR</td></tr></table>>];
  user_roles [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1f4e79"><font color="white"><b>user_roles</b> (V1)</font></td></tr>
   <tr><td align="left"><u>user_id, role_id</u></td></tr></table>>];
  audit_logs [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1f4e79"><font color="white"><b>audit_logs</b> (V1)</font></td></tr>
   <tr><td align="left"><u>id</u> · event_type · subject_email</td></tr><tr><td align="left">outcome · detail · origin_ip · created_at</td></tr><tr><td align="left"><i>sin FK: sobrevive a la eliminación</i></td></tr></table>>];
  sessions [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1f4e79"><font color="white"><b>sessions</b> (V2)</font></td></tr>
   <tr><td align="left"><u>id</u> · user_id FK · token_id UK</td></tr><tr><td align="left">created_at · expires_at · revoked</td></tr></table>>];
  providers [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1f4e79"><font color="white"><b>providers</b> (V3)</font></td></tr>
   <tr><td align="left"><u>id</u> · user_id FK UK · created_at</td></tr></table>>];
  businesses [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1f4e79"><font color="white"><b>businesses</b> (V3)</font></td></tr>
   <tr><td align="left"><u>id</u> · provider_id FK · name · created_at</td></tr><tr><td align="left" bgcolor="#e2efda">min_advance_hours 1–720 (V6, HU-08)</td></tr></table>>];
  mfa [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1f4e79"><font color="white"><b>mfa</b> (V4)</font></td></tr>
   <tr><td align="left"><u>id</u> · user_id FK UK · secret · enabled</td></tr></table>>];
  services [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#548235"><font color="white"><b>services</b> (V5, HU-09)</font></td></tr>
   <tr><td align="left"><u>id</u> · business_id FK · name · description</td></tr><tr><td align="left">duration_minutes &gt;0 · price_cop BIGINT ≥0 · active</td></tr><tr><td align="left">created_by FK · created_at · updated_at</td></tr><tr><td align="left">UK (business_id, lower(name))</td></tr></table>>];
  resources [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#548235"><font color="white"><b>resources</b> (V7, HU-14)</font></td></tr>
   <tr><td align="left"><u>id</u> · business_id FK · name</td></tr><tr><td align="left">type SALA|EQUIPO|PERSONAL · active</td></tr><tr><td align="left">created_by FK · created_at · updated_at</td></tr><tr><td align="left">UK (business_id, lower(name))</td></tr></table>>];
  service_resources [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#548235"><font color="white"><b>service_resources</b> (V8, HU-18)</font></td></tr>
   <tr><td align="left"><u>service_id, resource_id</u> · created_at</td></tr></table>>];
  resource_availability [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#548235"><font color="white"><b>resource_availability</b> (V9, HU-19)</font></td></tr>
   <tr><td align="left"><u>id</u> · resource_id FK</td></tr><tr><td align="left">day_of_week 1–7 · start_time &lt; end_time</td></tr></table>>];
  bookings [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#548235"><font color="white"><b>bookings</b> (V10–V12, HU-22…28)</font></td></tr>
   <tr><td align="left"><u>id</u> · client_id · business_id · service_id · resource_id (FK)</td></tr>
   <tr><td align="left">copias: client_email · client_name (V11) · business_name</td></tr>
   <tr><td align="left">service_name · resource_name · price_cop</td></tr>
   <tr><td align="left">start_at · end_at · status CONFIRMADA|CANCELADA|COMPLETADA</td></tr>
   <tr><td align="left">cancel_origin (V12) · cancel_reason · cancelled_at · created_at</td></tr>
   <tr><td align="left">EXCLUDE gist (resource_id, tstzrange) WHERE CONFIRMADA</td></tr></table>>];

  users -> user_roles [label="CASCADE"];
  roles -> user_roles [label="RESTRICT"];
  users -> sessions [label="CASCADE"];
  users -> mfa [label="CASCADE", arrowhead=teeodot];
  users -> providers [label="CASCADE", arrowhead=teeodot];
  providers -> businesses [label="CASCADE"];
  businesses -> services [label="CASCADE"];
  businesses -> resources [label="CASCADE"];
  users -> services [label="created_by SET NULL", arrowtail=teeodot, style=dashed];
  users -> resources [label="created_by SET NULL", arrowtail=teeodot, style=dashed];
  services -> service_resources [label="CASCADE"];
  resources -> service_resources [label="CASCADE"];
  resources -> resource_availability [label="CASCADE"];
  users -> bookings [label="client SET NULL", arrowtail=teeodot];
  businesses -> bookings [label="SET NULL", arrowtail=teeodot];
  services -> bookings [label="SET NULL", arrowtail=teeodot];
  resources -> bookings [label="SET NULL", arrowtail=teeodot];
}

@startuml Diagrama_de_Componentes_Monolito_Modular

top to bottom direction

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho

' =========================================================
' BACKEND - SPRING BOOT
' =========================================================

package "BACKEND - SPRING BOOT" {

    ' =====================================================
    ' MÓDULOS DE NEGOCIO
    ' =====================================================

    package "Módulos de negocio" #E3F2FD {

        component "Identity & Access" as Identity
        component "Provider" as Provider
        component "Service" as Service
        component "Resource" as Resource
        component "Reservation" as Reservation
        component "Report" as Report

        ' Relaciones funcionales principales
        Service ..> Reservation : servicios
        Resource ..> Reservation : recursos
    }


    ' =====================================================
    ' SERVICIOS TRANSVERSALES
    ' =====================================================

    package "Servicios transversales" #FFF3E0 {

        component "Authorization Service" as Authorization
        component "Audit Service" as Audit
    }


    ' =====================================================
    ' PERSISTENCIA
    ' =====================================================

    package "Persistencia" #E8F5E9 {

        component "Persistence / JPA" as Persistence
    }


    ' =====================================================
    ' DEPENDENCIAS ARQUITECTÓNICAS
    ' =====================================================

    "Módulos de negocio" ..> "Servicios transversales" : autorización / auditoría

    "Módulos de negocio" ..> Persistence : persistencia

    "Servicios transversales" ..> Persistence : persistencia
}


' =========================================================
' BASE DE DATOS
' =========================================================

database "PostgreSQL" as PostgreSQL

Persistence ..> PostgreSQL : JDBC / JPA


' =========================================================
' CONTROL DEL LAYOUT
' =========================================================

Identity -[hidden]right- Provider
Provider -[hidden]right- Service
Service -[hidden]right- Resource
Resource -[hidden]right- Reservation
Reservation -[hidden]right- Report

Authorization -[hidden]right- Audit

"Módulos de negocio" -[hidden]down- "Servicios transversales"
"Servicios transversales" -[hidden]down- Persistencia
Persistencia -[hidden]down- PostgreSQL

@enduml

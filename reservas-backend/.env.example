# Copiar como .env y completar con valores reales. NUNCA subir el .env real
# al repositorio (ver .gitignore). Lineamientos Sec. 7.3: "preferiblemente
# usar servicios de Secretos como Servicio o variables de ambiente ocultas
# con archivos .env cuando se requiera".

DB_URL=jdbc:postgresql://localhost:5432/reservas
DB_USERNAME=reservas_app
DB_PASSWORD=change-me

# Sin perfil por defecto (SEC-05): para trabajar en local hay que pedir dev; en el servidor, prod.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Opcionales (valores por defecto entre paréntesis)
# CORS_ALLOWED_ORIGINS=https://app.example.com    (vacío = ningún origen de navegador)
# MAX_REQUEST_BODY_BYTES=65536
# SWAGGER_ENABLED=false                            (true publica /swagger-ui.html)

# ADR-002-autenticacion-y-sesiones.md: clave HMAC para firmar JWT (minimo
# 32 caracteres / 256 bits). Generar una real por entorno, nunca reutilizar
# el valor de ejemplo. Sin filtro conectado en Sprint 1 (ver JwtTokenProvider).
JWT_SECRET=change-me-to-a-real-secret-of-at-least-32-characters

# Bootstrap del primer ADMINISTRADOR (AdminBootstrapRunner). Opcional: si no
# se definen, no pasa nada. Solo actua si todavia no existe ningun
# administrador. Definir estas variables en el entorno del servidor, arrancar
# una vez y luego QUITAR BOOTSTRAP_ADMIN_PASSWORD del entorno.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=change-me-Segura#2026
# BOOTSTRAP_ADMIN_CELLPHONE=3001234567
# BOOTSTRAP_ADMIN_FULL_NAME=Administrador inicial